# AI-Ops Insights Generator Environment Configuration

# Base URL for the AI-Ops platform (without the API path)
AIOPS_DOMAIN=https://edge.staging.example.com
# AIOPS_BASE_URL=https://www.example.com
AIOPS_BASE_URL=https://edge.staging.example.com

# Base URL for Aegis API calls (optional, falls back to AIOPS_DOMAIN)
# AEGIS_DOMAIN=https://www.example.com
AEGIS_DOMAIN=https://edge.staging.example.com

# Bearer token for authentication (optional)
AIOPS_TOKEN=<token>

# Number of devices to generate in the device inventory (default: 50)
# AIOPS_DEVICE_COUNT=1

AIOPS_DEVICE_SELECTION=sequential

INSIGHT_PICKER=sequential

# Generation mode: 'device' or 'insight' (default: insight)
AIOPS_SEVERITY_MODE=pinned
GENERATION_MODE=device

# Number of devices to use in device mode (default: 3)
AIOPS_DEVICE_COUNT=4
